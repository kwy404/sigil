{
  "expo": {
    "name": "Sigil",
    "slug": "kaway401",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sigil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kwy404.sigil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070B15",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kwy404.sigil"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B15",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "pt-BR", "es", "fr", "de", "it", "ja", "zh-Hans"],
            "android": ["en", "pt-BR", "es", "fr", "de", "it", "ja", "zh-Hans"]
          }
        }
      ],
      "./modules/sigil-control/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "10051fdb-d939-4ce4-a742-ef60c1aa0688"
      }
    }
  }
}
