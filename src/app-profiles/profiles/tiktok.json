{
  "schemaVersion": 1,
  "id": "tiktok",
  "name": "TikTok",
  "description": "Vertical feed. Flicks move between videos, a double pinch likes the video under the cursor.",
  "packages": ["com.zhiliaoapp.musically", "com.ss.android.ugc.trill"],
  "aliases": ["tik tok"],
  "bindings": {
    "flick_up": { "type": "swipe", "direction": "up" },
    "flick_down": { "type": "swipe", "direction": "down" },
    "swipe_two_left": { "type": "swipe", "direction": "left" },
    "swipe_two_right": { "type": "swipe", "direction": "right" }
  },
  "selectors": {
    "search": {
      "contentDescription": ["Search", "Pesquisar"]
    },
    "like": {
      "contentDescription": ["Like", "Curtir", "Me gusta", "J'aime", "Gefällt mir", "Mi piace", "いいね", "点赞"]
    },
    "inboxTab": {
      "contentDescription": ["Inbox", "Caixa de entrada", "Bandeja de entrada", "Boîte de réception", "Posteingang", "Posta in arrivo", "受信トレイ", "收件箱", "消息"]
    },
    "profileTab": {
      "contentDescription": ["Profile", "Perfil", "Profil", "Profilo", "プロフィール", "主页", "我"]
    }
  },
  "places": {
    "messages": { "tab": "inboxTab" },
    "profile": { "tab": "profileTab" }
  }
}
