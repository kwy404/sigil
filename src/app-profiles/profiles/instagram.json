{
  "schemaVersion": 1,
  "id": "instagram",
  "name": "Instagram",
  "description": "Feed, Reels and Stories. Posting always stops for confirmation before Share.",
  "packages": ["com.instagram.android"],
  "aliases": ["insta", "ig"],
  "bindings": {
    "flick_up": { "type": "swipe", "direction": "up" },
    "flick_down": { "type": "swipe", "direction": "down" },
    "swipe_two_left": { "type": "swipe", "direction": "left" },
    "swipe_two_right": { "type": "swipe", "direction": "right" }
  },
  "selectors": {
    "create": {
      "contentDescription": ["Create", "New post", "Criar", "Nova publicação"]
    },
    "next": {
      "text": ["Next", "Avançar"],
      "contentDescription": ["Next", "Avançar"]
    },
    "captionInput": {
      "resourceId": ["com.instagram.android:id/caption_input_text_view"],
      "text": ["Write a caption...", "Escreva uma legenda..."]
    },
    "share": {
      "text": ["Share", "Compartilhar"],
      "contentDescription": ["Share", "Compartilhar"],
      "commit": true
    },
    "like": {
      "resourceId": ["com.instagram.android:id/row_feed_button_like"],
      "contentDescription": ["Like", "Curtir", "Me gusta", "J'aime", "Gefällt mir", "Mi piace", "いいね！", "赞"]
    },
    "profileTab": {
      "resourceId": ["com.instagram.android:id/profile_tab"],
      "contentDescription": ["Profile", "Perfil", "Profil", "Profilo", "プロフィール", "主页", "个人主页"]
    }
  },
  "links": {
    "launch": "instagram://"
  },
  "places": {
    "reels": { "link": "https://www.instagram.com/reels/" },
    "messages": { "link": "https://www.instagram.com/direct/inbox/" },
    "explore": { "link": "https://www.instagram.com/explore/" },
    "profile": { "tab": "profileTab" }
  }
}
